# ─────────────────────────────────────────────────────────────────────────────
# Banco de dados (Postgres)
# Provedor recomendado: Neon (neon.tech), Supabase, ou Vercel Postgres
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ─────────────────────────────────────────────────────────────────────────────
# Infobip — preencha antes de rodar
# ─────────────────────────────────────────────────────────────────────────────
INFOBIP_BASE_URL=https://XXXXX.api.infobip.com
INFOBIP_API_KEY=           # secreta — escopo whatsapp:message:send + template management
INFOBIP_SENDER=            # número WhatsApp registrado (só dígitos, ex: 5511999999999)

# Trava de teste: TODOS os envios vão para este número enquanto setada
# Remova apenas quando for para produção
TEST_OVERRIDE_PHONE=5511995903793

# ─────────────────────────────────────────────────────────────────────────────
# Gupy
# ─────────────────────────────────────────────────────────────────────────────
GUPY_API_TOKEN=            # token da API Gupy (painel Gupy → Integrações → API)

# Secret enviado nos headers dos webhooks (crie um valor aleatório forte)
# Ex: openssl rand -hex 32
GUPY_WEBHOOK_SECRET=

# Dados do responsável técnico (exigidos pela API de webhooks da Gupy)
GUPY_TECH_OWNER_NAME=
GUPY_TECH_OWNER_EMAIL=

# URL pública base da aplicação (usada para mídia de templates MEDIA)
# Em produção: https://seu-dominio.com
# Em desenvolvimento: deixe em branco ou use ngrok
PUBLIC_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Admin
# ─────────────────────────────────────────────────────────────────────────────
# Protege as rotas /api/gupy/sync e /api/gupy/jobs
# Envie no header: x-admin-secret: <valor>
# Ex: openssl rand -hex 32
ADMIN_SECRET=
